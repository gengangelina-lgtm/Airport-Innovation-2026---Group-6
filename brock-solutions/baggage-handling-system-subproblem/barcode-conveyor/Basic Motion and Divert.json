[{"id":"452e7ba526faa00b","type":"tab","label":"Basic Motion and Divert","disabled":false,"info":"program allows user to:\r\n - set belt direction\r\n - turn belt on/off \r\n - calculate conveyor speed\r\n - detect object using proximity sensor and divert it\r\n - actuate diverter\r\n\r\n global variables can be configured by changing the values in 'config'","env":[]},{"id":"a90b53d76c105cfa","type":"inject","z":"452e7ba526faa00b","name":"on","props":[{"p":"payload"},{"p":"topic","vt":"str"}],"repeat":"","crontab":"","once":false,"onceDelay":0.1,"topic":"","payload":"beltVoltage","payloadType":"global","x":230,"y":240,"wires":[["737bb763fd59e7c6"]]},{"id":"c0dad6338c7da7c4","type":"inject","z":"452e7ba526faa00b","name":"off","props":[{"p":"payload"},{"p":"topic","vt":"str"}],"repeat":"","crontab":"","once":false,"onceDelay":0.1,"topic":"","payload":"0","payloadType":"num","x":230,"y":300,"wires":[["737bb763fd59e7c6"]]},{"id":"737bb763fd59e7c6","type":"groov-io-write","z":"452e7ba526faa00b","device":"1d984926.1d3e57","dataType":"channel-analog","moduleIndex":"","channelIndex":"7","mmpAddress":"0xF0D81000","mmpType":"int32","mmpLength":"1","mmpEncoding":"ascii","value":"","valueType":"msg.payload","name":"set on","x":410,"y":240,"wires":[[]]},{"id":"122e93c763e0071e","type":"groov-io-input","z":"452e7ba526faa00b","device":"1d984926.1d3e57","dataType":"channel-digital-feature-value","moduleIndex":"","channelIndex":"0","mmpAddress":"0xF0D81000","mmpType":"int32","mmpLength":"1","mmpEncoding":"ascii","sendInitialValue":true,"deadband":"1","scanTimeSec":"1.0","name":"encoder","x":220,"y":400,"wires":[["a659ea4962c466f5"]]},{"id":"a659ea4962c466f5","type":"function","z":"452e7ba526faa00b","name":"calc speed","func":"// constants\nvar countsPerRev = 700;\nvar gearRatio = 4; // 1:4 pulley ratio\nvar circumference = 10.5 * 3.14; // 10.5 cm diameter\n\n// current time in ms since Jan 1st, 1970\nvar current_time = new Date().getTime();\n// current motor encoder value\nvar current_count = msg.payload;\n\n// time elapsed, in ms\nvar elapsed = current_time - flow.get(\"prev_time\");\n\nif (elapsed > 1000) {\n    // calc distance (in cm) travelled in elapsed time\n    var distance = ((current_count - flow.get(\"prev_count\")) / (countsPerRev * gearRatio)) * circumference;\n\n    // calc speed in cm/sec\n    // set as global variable\n    global.set(\"linearSpeed\", distance / (elapsed / 1000));\n\n    // reset counters\n    flow.set(\"prev_count\", current_count);\n    flow.set(\"prev_time\", current_time);\n\n    //debug msg\n    msg.speed = global.get(\"linearSpeed\");\n}\n\n//end\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"// Code added here will be run once\n// whenever the node is started.\n\n// set inital time and count\nflow.set(\"prev_time\", new Date().getTime());\nflow.set(\"prev_count\", 0);","finalize":"","libs":[],"x":430,"y":400,"wires":[["bef52305c52852fe"]]},{"id":"bef52305c52852fe","type":"debug","z":"452e7ba526faa00b","name":"speed","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"speed","targetType":"msg","statusVal":"","statusType":"auto","x":610,"y":400,"wires":[]},{"id":"628c16a2cfb8363d","type":"groov-io-input","z":"452e7ba526faa00b","device":"1d984926.1d3e57","dataType":"channel-analog","moduleIndex":"","channelIndex":"2","mmpAddress":"0xF0D81000","mmpType":"int32","mmpLength":"1","mmpEncoding":"ascii","sendInitialValue":false,"deadband":"0.6","scanTimeSec":"1.0","name":"proxy1","x":210,"y":580,"wires":[["4aa958a5b5057a89"]]},{"id":"1c4e897b2ada7002","type":"trigger","z":"452e7ba526faa00b","name":"trigger","op1":"1","op2":"0","op1type":"str","op2type":"str","duration":"0","extend":false,"overrideDelay":false,"units":"ms","reset":"","bytopic":"all","topic":"topic","outputs":1,"x":610,"y":580,"wires":[["4b61c9742dd1950c"]]},{"id":"4b61c9742dd1950c","type":"function","z":"452e7ba526faa00b","name":"calc delay","func":"// constants\n// adjust as needed\nvar dist = global.get(\"proxyDist\"); // in cm\n\n// speed in cm/sec\nvar speed = global.get(\"linearSpeed\");\n\n// calc time and convert to ms\nmsg.delay = ( dist / speed ) * 1000;\n\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":800,"y":580,"wires":[["55dee389944a2bf3","4a56e2ec88c4b1bf"]]},{"id":"5f0d306484d3c42e","type":"inject","z":"452e7ba526faa00b","name":"FW","props":[{"p":"payload"},{"p":"topic","vt":"str"}],"repeat":"","crontab":"","once":false,"onceDelay":0.1,"topic":"","payload":"3","payloadType":"num","x":230,"y":80,"wires":[["c9ea1a6b560a7c73"]]},{"id":"1c7a28af4948f0b8","type":"inject","z":"452e7ba526faa00b","name":"BWD","props":[{"p":"payload"},{"p":"topic","vt":"str"}],"repeat":"","crontab":"","once":false,"onceDelay":0.1,"topic":"","payload":"0","payloadType":"num","x":230,"y":140,"wires":[["c9ea1a6b560a7c73"]]},{"id":"c9ea1a6b560a7c73","type":"groov-io-write","z":"452e7ba526faa00b","device":"1d984926.1d3e57","dataType":"channel-analog","moduleIndex":"","channelIndex":"6","mmpAddress":"0xF0D81000","mmpType":"int32","mmpLength":"1","mmpEncoding":"ascii","value":"","valueType":"msg.payload","name":"set belt dir","x":430,"y":80,"wires":[[]]},{"id":"55dee389944a2bf3","type":"delay","z":"452e7ba526faa00b","name":"delay","pauseType":"delayv","timeout":"5","timeoutUnits":"milliseconds","rate":"1","nbRateUnits":"1","rateUnits":"second","randomFirst":"1","randomLast":"5","randomUnits":"seconds","drop":false,"allowrate":false,"outputs":1,"x":990,"y":580,"wires":[["9a9296e7ec90e0a1"]]},{"id":"1f7374b3b105b90a","type":"change","z":"452e7ba526faa00b","name":"","rules":[{"t":"set","p":"reset","pt":"msg","to":"false","tot":"bool"}],"action":"","property":"","from":"","to":"","reg":false,"x":1380,"y":580,"wires":[["1c4e897b2ada7002"]]},{"id":"a92c3d39f748390f","type":"link in","z":"452e7ba526faa00b","name":"divert","links":[],"x":185,"y":760,"wires":[["f9b94976fa3199e4"]]},{"id":"f9b94976fa3199e4","type":"groov-io-write","z":"452e7ba526faa00b",